# ---- Credentials: never upload these -------------------------------------
.streamlit/secrets.toml
*.key
*service-account*.json
*credentials*.json
.env

# ---- Python / Jupyter clutter ---------------------------------------------
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# ---- Large or generated data files (the data lives in BigQuery) ----------
*.parquet
*.zip
*.gz
census_output/
population_output/
*.csv
# ...except the small app data files in data/, which the app reads
!data/*.csv

# ---- Personal editor settings (your own Python path) ----------------------
.vscode/settings.json

# ---- Operating-system files -----------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
