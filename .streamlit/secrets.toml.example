# Copy this file to  .streamlit/secrets.toml  (same folder) and fill in your values.
# secrets.toml is listed in .gitignore, so it never goes to GitHub. Never commit real keys.
# Without secrets.toml the app still runs, using placeholder data.

[bigquery]
project = "your-gcp-project-id"
dataset = "femicide_project"

# Option A: shared service-account key (the project lead sends the values privately).
# Paste the fields from the key's .json file here. Delete this whole section to use option B.
[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@your-gcp-project-id.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"

# Option B: your own Google login. Delete the [gcp_service_account] section above and run once:
#   gcloud auth application-default login
